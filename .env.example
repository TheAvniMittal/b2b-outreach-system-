# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL / Neon)
# ==============================================================================
DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require

# ==============================================================================
# GROQ AI CONFIGURATION (Primary Inference Provider)
# ==============================================================================
GROQ_API_KEY=
A2_MODEL=llama-3.3-70b-versatile
A2_TEMPERATURE=0.3
A3_MODEL=llama-3.1-8b-instant
A3_TEMPERATURE=0.0
STUDIO_MODEL=llama-3.1-8b-instant
STUDIO_TEMPERATURE=0.8
GROQ_DAILY_RESET_UTC=00:00

# ==============================================================================
# EMAIL SENDING CONFIGURATION (SMTP / Gmail)
# ==============================================================================
SMTP_GMAIL=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ==============================================================================
# PIPELINE CONTROLS & SAFETY GATES
# ==============================================================================
LIVE_EMAIL_SENDING=false
TEST_MODE=true
SEED_SENDING_ENABLED=true
TARGET_DAILY_SENDS=20
RAMP_TARGET=50

# ==============================================================================
# PHASE 9: CATALOGUE ATTACHMENT & STORAGE
# ==============================================================================
MAX_ATTACHMENT_SIZE_MB=5
CATALOGUES_DIR=catalogues
BASE_CATALOGUE_URL=http://127.0.0.1:8000/api/catalogues/download/
